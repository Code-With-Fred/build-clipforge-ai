# =============================================================================
# AgencyOS AI — environment variables
# -----------------------------------------------------------------------------
# Copy to .env.local for development. In production, set these in Vercel →
# Project → Settings → Environment Variables. Never commit real values.
#
# Only NEXT_PUBLIC_* variables reach the browser. NO secret may ever use the
# NEXT_PUBLIC_ prefix.
#
# Generate secrets with:   openssl rand -base64 48
#                      or: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# --- Application -------------------------------------------------------------
# Public base URL (no trailing slash). Used for links, redirects and CSRF checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---------------------------------------------
# Connect as the dedicated, RLS-restricted `agencyos_app` role created by the
# migrations — NOT as `postgres`. After `supabase db push`, run once in SQL:
#   alter role agencyos_app with login password '<generated secret>';
# Use the Supavisor transaction pooler (port 6543) on Vercel. The username
# format for the pooler is agencyos_app.<project-ref>.
DATABASE_URL=postgres://agencyos_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: 'disable' | 'require' | 'verify'. Default: disable for localhost,
# otherwise 'verify' if DATABASE_CA_CERT is set, else 'require'.
DATABASE_SSL=
# Optional: Supabase root CA (PEM, \n-escaped) for full certificate verification.
DATABASE_CA_CERT=
# Optional: connection pool size per serverless instance (default 5).
DATABASE_POOL_MAX=5

# --- Supabase project (Storage) ------------------------------------------------
# Server-side only. Used to store organization logos in the private
# `org-assets` bucket. The service role key bypasses Storage policies — it is
# only ever used on the server after membership/role checks.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=org-assets
# Not required by the app (it never queries Supabase from the browser). Listed
# for completeness; RLS denies the anon/authenticated roles all table access.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Authentication (Better Auth) ----------------------------------------------
# At least 32 characters. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks. Defaults to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- AI (Google Gemini) ------------------------------------------------------
# https://aistudio.google.com/apikey — without it, AI features show a setup
# state; audits still produce measured findings and scores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=45000

# --- Optional: Google PageSpeed Insights (Core Web Vitals) ---------------------
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- Payments (Stripe, one-time license purchases) ---------------------------
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at <APP_URL>/api/stripe/webhook with events:
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# One-time Price IDs (mode: payment) for each purchasable plan.
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_AGENCY=

# --- Licensing -----------------------------------------------------------------
# At least 32 characters. Derives the HMAC key (lookup hash) and AES-256-GCM key
# (encrypted storage) for license keys. Losing it makes existing keys
# unverifiable — store it in your secrets manager.
LICENSE_SECRET=

# --- Email (Resend) — optional ---------------------------------------------------
# Enables password reset emails, invitation emails, license delivery and the
# explicit "Send welcome email" action. Nothing is ever sent automatically.
RESEND_API_KEY=
EMAIL_FROM="AgencyOS AI <no-reply@your-domain.com>"
# Where contact-form submissions are forwarded (they are always stored in the DB).
CONTACT_INBOX_EMAIL=
